<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_bg">
    <TextView android:id="@+id/w_name" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="#C9543F" android:textSize="15sp" android:textStyle="bold" android:text="Bebenou" />
    <TextView android:id="@+id/w_feed" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:textColor="#1C1412" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/w_diaper" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="3dp" android:textColor="#1C1412" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/w_sleep" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="3dp" android:textColor="#1C1412" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" />
</LinearLayout>
